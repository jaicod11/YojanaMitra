# Primary keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional additional keys per provider, tried in order when one reports its
# daily cap. Numbered _2 .. _9; gaps are tolerated.
GEMINI_API_KEY_2=
GROQ_API_KEY_2=

# CORS for the API (backend/app/main.py). Comma-separated exact origins that may
# call POST /match from a browser; no wildcards. Defaults to the Lovable dev
# server, http://localhost:8080. At deploy time, add the deployed frontend's
# origin, e.g. http://localhost:8080,https://<deployed-frontend-domain>
ALLOWED_ORIGINS=http://localhost:8080
