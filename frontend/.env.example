# Copy to .env.local (git-ignored) and adjust. Vite builds these values into
# the app, so a change needs a dev-server restart or a new build.

# Base URL of the YojanaMitra API (backend/app/main.py), without a trailing
# slash. Locally, start the API from the repo root with
#   uvicorn app.main:app --app-dir backend --port 8000
# The API only accepts browser requests from the origins in its
# ALLOWED_ORIGINS setting (repo-root .env.example); the dev server here runs
# on http://localhost:8080.
VITE_API_BASE_URL=http://localhost:8000

# "true" serves built-in mock results instead of calling the API, for working
# on the UI offline. Anything else, or unset, calls the real API.
VITE_USE_MOCK=false
